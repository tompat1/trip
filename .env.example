# Baseline Environment Variables
# Copy this file to .env and configure secrets as needed.

# Application Keys
# API_KEY=your_key_here

# Tourism POI enrichment
# Browser fallback for local development:
# VITE_OPENTRIPMAP_API_KEY=your_opentripmap_key_here
# Worker secret for production:
# npx wrangler secret put OPENTRIPMAP_API_KEY
# OPENTRIPMAP_API_KEY=your_opentripmap_key_here

# Image federation / place media enrichment
# Open providers are used without keys where possible: Wikimedia Commons, Openverse, Panoramax, Art Institute of Chicago.
# Worker secrets for production:
# npx wrangler secret put FLICKR_API_KEY
# npx wrangler secret put MAPILLARY_ACCESS_TOKEN
# npx wrangler secret put UNSPLASH_ACCESS_KEY
# npx wrangler secret put PEXELS_API_KEY
# npx wrangler secret put RIJKSMUSEUM_API_KEY
# npx wrangler secret put SMITHSONIAN_API_KEY
# FLICKR_API_KEY=your_flickr_key_here
# MAPILLARY_ACCESS_TOKEN=your_mapillary_token_here
# UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here
# PEXELS_API_KEY=your_pexels_key_here
# RIJKSMUSEUM_API_KEY=your_rijksmuseum_key_here
# SMITHSONIAN_API_KEY=your_smithsonian_key_here
# Optional Panoramax-compatible STAC API override:
# PANORAMAX_API_BASE=https://api.panoramax.xyz/api

# Event enrichment
# Worker secrets for production:
# npx wrangler secret put TICKETMASTER_API_KEY
# npx wrangler secret put BANDSINTOWN_APP_ID
# Optional browser fallbacks for local development only:
# VITE_TICKETMASTER_API_KEY=your_ticketmaster_key_here
# VITE_BANDSINTOWN_APP_ID=your_bandsintown_app_id_here
# VITE_OPENAGENDA_API_KEY=your_openagenda_key_here

# Flight search
# Worker secrets for production:
# npx wrangler secret put AMADEUS_CLIENT_ID
# npx wrangler secret put AMADEUS_CLIENT_SECRET
# Optional: defaults to https://test.api.amadeus.com
# AMADEUS_API_BASE=https://test.api.amadeus.com

# Route planning / multimodal directions
# OpenTripPlanner is usually self-hosted or pointed at a trusted regional instance.
# If this is a bare host, the Worker appends /otp/gtfs/v1.
# OPENTRIPPLANNER_API_BASE=https://otp.example.org

# Worker role boundary
# Set as a Cloudflare Worker secret in production:
# npx wrangler secret put TRIP_ADMIN_TOKEN
# TRIP_ADMIN_TOKEN=change-me

# D1-backed admin login bootstrap
# Set these as Worker secrets, then sign in once from Profile -> Admin access.
# The Worker will create/update the D1 admin user with a password hash.
# npx wrangler secret put TRIP_ADMIN_EMAIL
# npx wrangler secret put TRIP_ADMIN_PASSWORD
# TRIP_ADMIN_EMAIL=admin@example.com
# TRIP_ADMIN_PASSWORD=change-me-too

# Frontend API boundary
# In production the app uses same-origin /api/* through the Cloudflare Worker.
# Local Vite dev falls back to the deployed Worker unless this is set.
# VITE_TRIP_API_BASE=https://trip.thomasrynell.workers.dev
