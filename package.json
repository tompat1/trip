{
  "name": "trip-travel-planner-deluxe",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.11.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:vite": "vite --host 127.0.0.1",
    "dev:worker": "npx wrangler dev --persist-to .wrangler/state",
    "start": "vite --host 127.0.0.1",
    "test": "node --test test/*.test.js",
    "test:smoke": "playwright test",
    "build": "vite build",
    "deploy": "vite build && npx wrangler deploy",
    "worker:check": "node --check worker/index.js",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@phosphor-icons/core": "^2.1.1",
    "gsap": "^3.15.0",
    "leaflet": "^1.9.4",
    "motion": "^12.43.0",
    "vite": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0"
  }
}
